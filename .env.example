# ---------- Proyecto ----------
COMPOSE_PROJECT_NAME=laravel-react

# ---------- Versiones de las imágenes ----------
PHP_VERSION=8.4
NODE_VERSION=24
MARIADB_VERSION=11.8
MAILPIT_VERSION=latest

# ---------- Puertos ----------
BACKEND_PORT=8000
FRONTEND_PORT=5173
DB_EXTERNAL_PORT=3307
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ---------- Backend (Laravel) ----------
APP_NAME=LaravelReact
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# ---------- Base de datos (MariaDB) ----------
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

# ---------- Correo (Mailpit) ----------
MAIL_FROM_ADDRESS=hola@example.com
MAIL_FROM_NAME=LaravelReact

# ---------- Frontend (React) ----------
VITE_API_URL=http://localhost:8000
